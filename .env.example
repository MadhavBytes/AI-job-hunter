# Application Settings
APP_NAME=AI Job Hunter
APP_VERSION=1.0.0
DEBUG=False

# Backend Configuration
PYTHON_ENV=production
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_PORT=8000

# Foorilla API Configuration
# Get your free API key from: https://foorilla.com/
FOORILLA_API_KEY=your_foorilla_api_key_here

# Ollama LLM Settings (for local AI)
# Make sure Ollama is running: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Database
DATABASE_URL=sqlite:///./data/job_hunter.db

# File Paths
UPLOADS_DIR=./resumes/uploads
DATA_DIR=./data
LOGS_DIR=./logs

# Application Limits
MAX_RESUME_SIZE_MB=5
MAX_WORKERS=4
BATCH_SIZE=10

# Optional ML features
ENABLE_ML_FEATURES=false

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
CORS_CREDENTIALS=true

# Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
